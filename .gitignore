# O repositório guarda só os trabalhos C1, C2 e C3.
# O resto da pasta da disciplina (PDFs, aulas, vídeos didáticos) fica fora.
/*
!/.gitignore
!/README.md
!/midia/
!/Unidade 1/
!/Unidade 2/
!/Unidade 3/
/Unidade 1/*
/Unidade 2/*
/Unidade 3/*
!/Unidade 1/TrabalhoC1/
!/Unidade 2/TrabalhoC2/
!/Unidade 3/TrabalhoC3/

# Slides didáticos dos trabalhos: só os .pptx prontos (a pasta fonte/ do gerador fica fora)
!/Apresentacoes_PPT/
/Apresentacoes_PPT/*
!/Apresentacoes_PPT/*.pptx
~$*

# Saídas de compilação e arquivos locais do Visual Studio
bin/
obj/
.vs/
*.user
*.suo

# Vídeos (pesados): as apresentações e as animações em MP4 são publicadas na Release
# "apresentacoes-finais" do GitHub; no repositório ficam só as animações em WebP (pasta midia/)
*.mp4

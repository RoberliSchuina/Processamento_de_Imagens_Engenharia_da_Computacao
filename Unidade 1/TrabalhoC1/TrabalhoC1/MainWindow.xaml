<!--
    TRABALHO C1 - PROCESSAMENTO DE IMAGENS
    Locomotiva a vapor 2D em WPF: rodas giratórias, bielas sincronizadas e
    deslocamento horizontal de ida e volta entre os limites da janela.

    Convenção usada (análoga ao exemplo do relógio): as partes móveis (rodas e
    bielas) são desenhadas com o ponto de referência em (0,0) e posicionadas /
    animadas apenas por meio de RenderTransform.
-->
<Window x:Class="TrabalhoC1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trabalho C1 - Locomotiva a Vapor (WPF 2D)"
        Width="1100" Height="420" MinWidth="760" MinHeight="360"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ================= PINCÉIS (cores reaproveitadas) ================= -->

        <!-- Degradê vertical que dá a impressão de cilindro à caldeira -->
        <LinearGradientBrush x:Key="CaldeiraBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#12301C" Offset="0"/>
            <GradientStop Color="#3D7A50" Offset="0.35"/>
            <GradientStop Color="#12301C" Offset="1"/>
        </LinearGradientBrush>

        <!-- Aço polido usado nas bielas, cilindro e guias -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6E6E6" Offset="0"/>
            <GradientStop Color="#8A8A8A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Latão dos detalhes (domo de vapor) -->
        <LinearGradientBrush x:Key="LataoBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8C6B1F" Offset="0"/>
            <GradientStop Color="#F2D16B" Offset="0.4"/>
            <GradientStop Color="#8C6B1F" Offset="1"/>
        </LinearGradientBrush>

        <!-- Brita + dormentes: pequeno desenho repetido (TileMode) ao longo da via -->
        <DrawingBrush x:Key="DormentesBrush" TileMode="Tile" Viewport="0,0,30,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#8C8274">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,30,14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#5A3E2B">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="6,0,18,7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ======================== TEMPLATE DA RODA ========================
             Modelo único (ControlTemplate) de onde saem TODAS as rodas.
             Centro em (0,0) e raio nominal de 40 px, de modo que a
             RotateTransform de cada instância gire a roda em torno do próprio
             eixo. As rodas menores reutilizam o mesmo modelo com ScaleTransform.
             ================================================================== -->
        <ControlTemplate x:Key="RodaTemplate" TargetType="Control">
            <Canvas>
                <!-- Aro externo (banda de rodagem de aço) -->
                <Ellipse Canvas.Left="-40" Canvas.Top="-40" Width="80" Height="80" Fill="#1C1C1C"/>
                <!-- Disco da roda -->
                <Ellipse Canvas.Left="-35" Canvas.Top="-35" Width="70" Height="70"
                         Fill="#A11D21" Stroke="#5E0F12" StrokeThickness="2"/>

                <!-- Contrapeso (segmento de círculo oposto ao pino da manivela).
                     Fica oculto por padrão e só aparece nas rodas motrizes (ver Triggers). -->
                <Path x:Name="contrapeso" Visibility="Collapsed" Fill="#5E0F12"
                      Data="M -24.4,-24.4 A 34.5,34.5 0 0 0 -24.4,24.4 Z"/>

                <!-- Raios: a mesma linha diametral repetida e girada de 30 em 30 graus
                     (6 linhas = 12 raios). São eles que tornam a rotação visível. -->
                <Line X1="-33" X2="33" Stroke="#E8C547" StrokeThickness="3"/>
                <Line X1="-33" X2="33" Stroke="#E8C547" StrokeThickness="3">
                    <Line.RenderTransform><RotateTransform Angle="30"/></Line.RenderTransform>
                </Line>
                <Line X1="-33" X2="33" Stroke="#E8C547" StrokeThickness="3">
                    <Line.RenderTransform><RotateTransform Angle="60"/></Line.RenderTransform>
                </Line>
                <Line X1="-33" X2="33" Stroke="#E8C547" StrokeThickness="3">
                    <Line.RenderTransform><RotateTransform Angle="90"/></Line.RenderTransform>
                </Line>
                <Line X1="-33" X2="33" Stroke="#E8C547" StrokeThickness="3">
                    <Line.RenderTransform><RotateTransform Angle="120"/></Line.RenderTransform>
                </Line>
                <Line X1="-33" X2="33" Stroke="#E8C547" StrokeThickness="3">
                    <Line.RenderTransform><RotateTransform Angle="150"/></Line.RenderTransform>
                </Line>

                <!-- Cubo (eixo) da roda -->
                <Ellipse Canvas.Left="-9" Canvas.Top="-9" Width="18" Height="18"
                         Fill="#333333" Stroke="#E8C547" StrokeThickness="2"/>
                <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#E8C547"/>
            </Canvas>

            <ControlTemplate.Triggers>
                <!-- Instâncias marcadas com Tag="Motriz" exibem o contrapeso -->
                <Trigger Property="Tag" Value="Motriz">
                    <Setter TargetName="contrapeso" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- Céu ao fundo -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6EC6FF" Offset="0"/>
            <GradientStop Color="#D8F0FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <!-- ======================= CENÁRIO (fixo) ======================= -->
        <!-- Gramado -->
        <Rectangle VerticalAlignment="Bottom" Height="95" Fill="#6B8E23"/>
        <!-- Brita e dormentes -->
        <Rectangle VerticalAlignment="Bottom" Height="14" Margin="0,0,0,78"
                   Fill="{StaticResource DormentesBrush}"/>
        <!-- Trilho (o topo fica a 94 px da borda inferior) -->
        <Rectangle VerticalAlignment="Bottom" Height="6" Margin="0,0,0,88" Fill="#4A4A4A"/>

        <!-- "Pista": Canvas que ocupa toda a largura da janela, apoiado sobre o
             trilho. Sua largura define até onde a locomotiva pode ir (ver code-behind). -->
        <Canvas x:Name="pista" VerticalAlignment="Bottom" Height="230" Margin="0,0,0,94">

            <!-- ====================== LOCOMOTIVA ======================
                 Todo o conjunto (corpo, rodas e bielas) fica agrupado neste
                 Canvas. A TranslateTransform abaixo é animada para deslocar a
                 locomotiva inteira na horizontal. Coordenadas locais:
                 x = 0..500 (traseira -> frente), y = 230 é o topo do trilho. -->
            <Canvas x:Name="locomotiva" Width="500" Height="230">
                <Canvas.RenderTransform>
                    <TranslateTransform X="0"/>
                </Canvas.RenderTransform>

                <!-- ============ CORPO ESTÁTICO (Rectangle / Polygon / Ellipse) ============ -->

                <!-- Chaminé (desenhada antes da caldeira para a base ficar escondida) -->
                <Polygon Points="360,76 384,76 396,24 348,24" Fill="#1A1A1A"/>
                <Rectangle Canvas.Left="344" Canvas.Top="16" Width="56" Height="10"
                           RadiusX="3" RadiusY="3" Fill="#2B2B2B"/>

                <!-- Domo de vapor (latão) e domo de areia -->
                <Ellipse Canvas.Left="240" Canvas.Top="46" Width="52" Height="50" Fill="{StaticResource LataoBrush}"/>
                <Ellipse Canvas.Left="168" Canvas.Top="56" Width="36" Height="36" Fill="#1F4D2E"/>

                <!-- Caldeira e suas cintas -->
                <Rectangle Canvas.Left="120" Canvas.Top="70" Width="300" Height="76" Fill="{StaticResource CaldeiraBrush}"/>
                <Rectangle Canvas.Left="200" Canvas.Top="70" Width="5" Height="76" Fill="#E8C547"/>
                <Rectangle Canvas.Left="300" Canvas.Top="70" Width="5" Height="76" Fill="#E8C547"/>
                <Rectangle Canvas.Left="380" Canvas.Top="70" Width="5" Height="76" Fill="#E8C547"/>

                <!-- Caixa de fumaça (frente da caldeira) e farol -->
                <Rectangle Canvas.Left="410" Canvas.Top="64" Width="42" Height="82"
                           RadiusX="4" RadiusY="4" Fill="#1A1A1A"/>
                <Rectangle Canvas.Left="424" Canvas.Top="46" Width="22" Height="18" Fill="#2B2B2B"/>
                <Ellipse Canvas.Left="440" Canvas.Top="48" Width="10" Height="14" Fill="#FFE680"/>

                <!-- Cabine do maquinista: parede, teto e janela -->
                <Rectangle Canvas.Left="20" Canvas.Top="42" Width="110" Height="108" Fill="#7A1E1E"/>
                <Rectangle Canvas.Left="10" Canvas.Top="30" Width="130" Height="14"
                           RadiusX="5" RadiusY="5" Fill="#1A1A1A"/>
                <Rectangle Canvas.Left="40" Canvas.Top="58" Width="44" Height="40" RadiusX="3" RadiusY="3"
                           Fill="#BFE6FF" Stroke="#E8C547" StrokeThickness="2"/>

                <!-- Chassi (longarina), passadiço e limpa-trilhos -->
                <Rectangle Canvas.Left="20" Canvas.Top="146" Width="455" Height="26" Fill="#262626"/>
                <Rectangle Canvas.Left="120" Canvas.Top="142" Width="345" Height="6" Fill="#A11D21"/>
                <Polygon Points="462,172 500,228 462,228" Fill="#A11D21" Stroke="#1A1A1A" StrokeThickness="2"/>

                <!-- ======================= RODAS =======================
                     Todas são instâncias do mesmo ControlTemplate. Cada uma recebe
                     um TransformGroup com ordem FIXA (usada no code-behind):
                       Children[0] ScaleTransform     -> tamanho da roda
                       Children[1] RotateTransform    -> giro em torno do eixo (animado)
                       Children[2] TranslateTransform -> posição do eixo na locomotiva -->

                <!-- Roda traseira: mesmo tamanho das motrizes (raio 40) e também ligada
                     à biela de acoplamento, por isso recebe Tag="Motriz" (contrapeso). -->
                <Control x:Name="rodaTraseira" Template="{StaticResource RodaTemplate}" Tag="Motriz">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="60" Y="190"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <!-- Roda-guia dianteira (pequena, raio 20) -->
                <Control x:Name="rodaGuia" Template="{StaticResource RodaTemplate}">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="438" Y="210"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <!-- Três rodas motrizes (raio 40), eixos em y = 190 -->
                <Control x:Name="rodaMotriz1" Template="{StaticResource RodaTemplate}" Tag="Motriz">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="150" Y="190"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <Control x:Name="rodaMotriz2" Template="{StaticResource RodaTemplate}" Tag="Motriz">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="240" Y="190"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <Control x:Name="rodaMotriz3" Template="{StaticResource RodaTemplate}" Tag="Motriz">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="330" Y="190"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <!-- ============ CILINDRO, GUIAS E CRUZETA ============ -->

                <!-- Guias por onde a cruzeta desliza -->
                <Rectangle Canvas.Left="345" Canvas.Top="179" Width="70" Height="3" Fill="{StaticResource MetalBrush}"/>
                <Rectangle Canvas.Left="345" Canvas.Top="198" Width="70" Height="3" Fill="{StaticResource MetalBrush}"/>

                <!-- Cruzeta + haste do pistão (origem no centro da cruzeta).
                     Só se move na horizontal; o X é calculado a cada quadro. -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="transCruzeta" X="404" Y="190"/>
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Left="0" Canvas.Top="-2.5" Width="70" Height="5" Fill="#D0D0D0"/>
                    <Rectangle Canvas.Left="-9" Canvas.Top="-8" Width="18" Height="16"
                               Fill="#7A7A7A" Stroke="#333333" StrokeThickness="1"/>
                </Canvas>

                <!-- Cilindro (desenhado depois da haste para escondê-la) -->
                <Rectangle Canvas.Left="413" Canvas.Top="172" Width="46" Height="36" RadiusX="4" RadiusY="4"
                           Fill="{StaticResource MetalBrush}" Stroke="#333333" StrokeThickness="1.5"/>

                <!-- ======================= BIELAS ======================= -->

                <!-- BIELA DE ACOPLAMENTO: liga os pinos da roda traseira e das três rodas motrizes.
                     Desenhada com o pino da roda traseira em (0,0); os pinos ficam a 0, 90, 180 e 270 px.
                     Ela não gira: cada ponto dela descreve um círculo de raio igual ao
                     da manivela (24 px). Isso é obtido COMBINANDO transformações:
                       [0] RotateTransform(-θ)   -> desfaz antecipadamente a rotação
                       [1] TranslateTransform(24) -> leva o pino até o raio da manivela
                       [2] RotateTransform(+θ)   -> gira junto com a roda (pino acompanha a roda)
                       [3] TranslateTransform    -> posiciona no centro da roda traseira
                     Resultado: posição = centro + 24·(cos θ, sen θ), orientação sempre horizontal.
                     Os ângulos [0] e [2] são animados pela mesma Storyboard das rodas. -->
                <Canvas x:Name="bielaAcoplamento">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="24" Y="0"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform X="60" Y="190"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Left="-7" Canvas.Top="-5" Width="284" Height="10" RadiusX="5" RadiusY="5"
                               Fill="{StaticResource MetalBrush}" Stroke="#333333" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="-6" Canvas.Top="-6" Width="12" Height="12" Fill="#E8C547" Stroke="#333333"/>
                    <Ellipse Canvas.Left="84" Canvas.Top="-6" Width="12" Height="12" Fill="#E8C547" Stroke="#333333"/>
                    <Ellipse Canvas.Left="174" Canvas.Top="-6" Width="12" Height="12" Fill="#E8C547" Stroke="#333333"/>
                    <Ellipse Canvas.Left="264" Canvas.Top="-6" Width="12" Height="12" Fill="#E8C547" Stroke="#333333"/>
                </Canvas>

                <!-- BIELA PRINCIPAL (motora): liga o pino da 2ª roda motriz à cruzeta.
                     Desenhada do pino (0,0) até a cruzeta (140,0). A cada quadro o
                     code-behind calcula:
                       TranslateTransform -> posição do pino da manivela
                       RotateTransform    -> inclinação necessária para alcançar a cruzeta -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="rotBiela" Angle="0"/>
                            <TranslateTransform x:Name="transBiela" X="264" Y="190"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Left="-6" Canvas.Top="-5" Width="152" Height="10" RadiusX="5" RadiusY="5"
                               Fill="{StaticResource MetalBrush}" Stroke="#333333" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="-7" Canvas.Top="-7" Width="14" Height="14" Fill="#E8C547" Stroke="#333333"/>
                    <Ellipse Canvas.Left="133" Canvas.Top="-7" Width="14" Height="14" Fill="#E8C547" Stroke="#333333"/>
                </Canvas>
            </Canvas>
        </Canvas>
    </Grid>
</Window>

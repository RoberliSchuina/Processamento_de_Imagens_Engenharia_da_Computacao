<!--
    TRABALHO C2 - PROCESSAMENTO DE IMAGENS
    Casa 3D em WPF: três cômodos + telhado triangular (GeometryModel3D /
    MeshGeometry3D / DiffuseMaterial), chão de granito texturizado, câmera
    perspectiva orbitando 180° na vertical e duas luzes direcionais girando
    em sentidos opostos.

    Sistema de coordenadas (unidades ~ metros): chão no plano y = 0, eixo Y
    para cima, casa centrada na origem. As malhas (geometrias) são montadas
    no code-behind (MainWindow.xaml.cs / Malhas.cs); aqui ficam a cena,
    os materiais, a câmera, as luzes e as animações.
-->
<Window x:Class="TrabalhoC2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trabalho C2 - Casa 3D (WPF)"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#9CCFF0">

    <Grid>
        <Viewport3D>

            <!-- ============================ CÂMERA ============================
                 Perspectiva, no nível da casa (y = 3) e olhando na horizontal
                 (LookDirection 0,0,-1), a 30 unidades da frente da casa.
                 A RotateTransform3D gira a câmera em torno do eixo X que passa
                 pelo centro da casa (0,3,0). Eixo (-1,0,0) + ângulo positivo
                 (regra da mão direita) => a câmera sobe, passa por cima do
                 telhado e chega ao lado oposto (fundos da casa) aos 180°. -->
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,3,30" LookDirection="0,0,-1" UpDirection="0,1,0"
                                   FieldOfView="60" NearPlaneDistance="0.1" FarPlaneDistance="2000">
                    <PerspectiveCamera.Transform>
                        <RotateTransform3D CenterX="0" CenterY="3" CenterZ="0">
                            <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="rotacaoCamera" Axis="-1,0,0" Angle="0"/>
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Viewport3D.Camera>

            <!-- ============================= LUZES ============================
                 Duas luzes direcionais brancas de média intensidade (#999999 = 60%).
                 Direção com 30° em relação ao chão: (cos 30°, -sen 30°, 0) = (0.866, -0.5, 0),
                 a segunda no sentido oposto, como um "sol" de cada lado da casa.
                 Cada uma gira 360° em torno do eixo vertical Y, em sentidos opostos. -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <DirectionalLight Color="#999999" Direction="0.866,-0.5,0">
                            <DirectionalLight.Transform>
                                <RotateTransform3D>
                                    <RotateTransform3D.Rotation>
                                        <AxisAngleRotation3D x:Name="rotacaoLuz1" Axis="0,1,0" Angle="0"/>
                                    </RotateTransform3D.Rotation>
                                </RotateTransform3D>
                            </DirectionalLight.Transform>
                        </DirectionalLight>

                        <DirectionalLight Color="#999999" Direction="-0.866,-0.5,0">
                            <DirectionalLight.Transform>
                                <RotateTransform3D>
                                    <RotateTransform3D.Rotation>
                                        <AxisAngleRotation3D x:Name="rotacaoLuz2" Axis="0,1,0" Angle="0"/>
                                    </RotateTransform3D.Rotation>
                                </RotateTransform3D>
                            </DirectionalLight.Transform>
                        </DirectionalLight>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- ======================= CHÃO + CASA ======================= -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>

                        <!-- Chão: plano subdividido em ladrilhos; cada ladrilho recebe a
                             imagem inteira de granito (repetição da textura). -->
                        <GeometryModel3D x:Name="chao">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <ImageBrush ImageSource="Texturas/granito.png"/>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>

                        <!-- Cômodos: uma cor sólida diferente para cada um -->
                        <GeometryModel3D x:Name="sala">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#F2C14E"/> <!-- amarelo -->
                            </GeometryModel3D.Material>
                        </GeometryModel3D>

                        <GeometryModel3D x:Name="cozinha">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#4F9DDE"/> <!-- azul -->
                            </GeometryModel3D.Material>
                        </GeometryModel3D>

                        <GeometryModel3D x:Name="quarto">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#6CBF6C"/> <!-- verde -->
                            </GeometryModel3D.Material>
                        </GeometryModel3D>

                        <!-- Telhado triangular (prisma) -->
                        <GeometryModel3D x:Name="telhado">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#B23A2E"/> <!-- vermelho telha -->
                            </GeometryModel3D.Material>
                        </GeometryModel3D>

                        <!-- Detalhes: porta e janelas (placas finas encostadas nas paredes) -->
                        <GeometryModel3D x:Name="porta">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#6B4226"/> <!-- madeira -->
                            </GeometryModel3D.Material>
                        </GeometryModel3D>

                        <GeometryModel3D x:Name="janelas">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#DDF3FF"/> <!-- vidro -->
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
    </Grid>

    <!-- =========================== ANIMAÇÕES =========================== -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Câmera: arco de 180° em 5 s; AutoReverse faz voltar pelo mesmo
                         caminho (mais 5 s) e RepeatBehavior mantém o loop para sempre. -->
                    <DoubleAnimation Storyboard.TargetName="rotacaoCamera" Storyboard.TargetProperty="Angle"
                                     From="0" To="180" Duration="0:0:5"
                                     AutoReverse="True" RepeatBehavior="Forever"/>

                    <!-- Luzes: uma volta completa (360°) em 10 s, em sentidos opostos -->
                    <DoubleAnimation Storyboard.TargetName="rotacaoLuz1" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="rotacaoLuz2" Storyboard.TargetProperty="Angle"
                                     From="0" To="-360" Duration="0:0:10" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
